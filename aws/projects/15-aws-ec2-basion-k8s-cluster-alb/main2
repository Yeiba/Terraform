resource "aws_lb" "k8s_worker" {
  name               = "k8s-worker-lb"
  internal           = false
  load_balancer_type = "network"
  subnets            = module.vpc.public_subnets

  enable_deletion_protection = false

  tags = {
    Name = "k8s-worker-lb"
  }
}

resource "aws_lb_target_group" "k8s_worker" {
  name     = "k8s-worker-tg"
  port     = 30000
  protocol = "TCP"
  vpc_id   = module.vpc.vpc_id
}

resource "aws_lb_listener" "k8s_worker" {
  load_balancer_arn = aws_lb.k8s_worker.arn
  port              = 80
  protocol          = "TCP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.k8s_worker.arn
  }
}

resource "aws_lb_target_group_attachment" "k8s_worker" {
  count = length(aws_instance.workers.*.id)
  target_group_arn = aws_lb_target_group.k8s_worker.arn
  target_id        = aws_instance.workers.*.id[count.index]
}

